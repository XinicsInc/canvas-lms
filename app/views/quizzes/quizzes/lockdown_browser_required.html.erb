<h1>
  <%= t('headers.requires_lockdown', "Respondus LockDown Browser Required") %>
</h1>

<p>
  <%= t(:requires_lockdown_1, "1. This quiz must only be taken through the latest version of the exam-only browser (TrustLock Browser). Quiz attempts and result viewing are only available through it.") %>
</p>

<% unless @lockdown_browser_download_url.blank? %>
  <p>
    <%= t(:requires_lockdown_2, "2. If you have not yet installed the latest version, please download and install the latest version of the exam-only browser through the link below.") %>
    <br />
    &nbsp;&nbsp;
    <%= link_to(t('download_lockdown_link', "[Download TrustLock Browser]"), @lockdown_browser_download_url) %>
  </p>
<% end %>

<p>
  <%= t(:requires_lockdown_3, "3. Once installation is complete, run the downloaded latest version of the exam-only browser, reconnect, and take the quiz.") %>
</p>
