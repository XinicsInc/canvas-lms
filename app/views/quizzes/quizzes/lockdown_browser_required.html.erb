<h1>
  <%= t('requires_lockdown_h', "TrustLock Browser Required") %>
</h1>

<p>
  <%= t(:requires_lockdown_1, "1. This quiz requires TrustLock Browser. Please launch TrustLock Browser to take this quiz or view your quiz results.") %>
</p>
<p>
  <%= t(:requires_lockdown_2, "2. Once TrustLock Browser has been installed, please use it to take this quiz.") %>
</p>

<% unless @lockdown_browser_download_url.blank? %>
  <p>
    <%= t('requires_lockdown_3', "3. If you have not already installed the browser, please download it from here") %>
    <br />
    &nbsp;&nbsp;
    <%= link_to(t('download_lockdown_link', "[Download TrustLock Browser]"), @lockdown_browser_download_url) %>
  </p>
<% end %>
